# demo (default): the form is simulated in the browser. Nothing is sent anywhere.
# api: submits to the documented B2C registration endpoints, and only when the page is
#      opened from a registration link (/b2c/customer-registration/<token>).
VITE_REGISTRATION_MODE=demo

# Optional base URL for api mode. Leave empty in development to use the Vite proxy to
# the local B2C server (B2C_DEV_TARGET, default http://localhost:5100).
VITE_REGISTRATION_API_BASE=
