# B2B service requests by email (Email Requests in the iPlanet Service portal).
# Kept apart from backend/.env and the B2C settings; read only by src/emailRequests.
# Claude (ANTHROPIC_API_KEY in backend/.env) drafts each email; nothing becomes a ticket until approved.
B2B_EMAIL_IMAP_HOST=mail.example.com
B2B_EMAIL_IMAP_PORT=993
B2B_EMAIL_IMAP_SECURE=true
B2B_EMAIL_USER=service-requests@example.com
B2B_EMAIL_PASSWORD=
B2B_EMAIL_MAILBOX=INBOX
B2B_EMAIL_POLL_MINUTES=2
# Ticket updates for requests that came by email are sent to the original sender from
# B2B_EMAIL_USER over SMTP. Leave B2B_EMAIL_SMTP_HOST empty to turn them off.
B2B_EMAIL_SMTP_HOST=mail.example.com
B2B_EMAIL_SMTP_PORT=465
B2B_EMAIL_SMTP_SECURE=true
B2B_EMAIL_FROM_NAME=iPlanet Service
# Hosts that block outgoing SMTP ports (Render's free plan blocks 25, 465 and 587) can send
# through Brevo's HTTPS API instead: create an API key at app.brevo.com > SMTP & API, verify
# B2B_EMAIL_USER as a sender there, and set the key here. When set, it is used instead of SMTP.
B2B_EMAIL_API_KEY=
# Optional: send from a different Brevo-verified address (e.g. while testing without
# authenticating your domain). Replies still come back to B2B_EMAIL_USER via Reply-To.
B2B_EMAIL_FROM_ADDRESS=
