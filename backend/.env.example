MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
FRONTEND_URLS=http://localhost:5173,https://your-vercel-app.vercel.app
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
# Claude fallback for Excel device imports: asked only when a mandatory column can't be
# matched by its heading or values. Leave the key empty to turn it off.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
 
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_MS=20000
# Log retrieved knowledge IDs and scores locally; never enable in production.
AI_KNOWLEDGE_DEBUG=false
# Google Business Profile reviews (see docs/google-business-profile.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-business/callback
GOOGLE_BUSINESS_SCOPE=https://www.googleapis.com/auth/business.manage
# Encrypts stored Google tokens; changing it requires reconnecting.
GOOGLE_BUSINESS_TOKEN_ENCRYPTION_KEY=
# Where the OAuth callback returns the browser (defaults to first FRONTEND_URLS entry + /service/reviews/google).
GOOGLE_BUSINESS_RETURN_URL=
# Optional Pub/Sub review notifications; leave empty to disable.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_PUSH_AUDIENCE=
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=
# Proactive device service (all optional; defaults shown)
# Days before the recommended date a device is "Upcoming", and days after it before "Due" becomes "Overdue".
SERVICE_UPCOMING_DAYS=30
SERVICE_OVERDUE_GRACE_DAYS=14
# Interval for devices without their own serviceIntervalMonths.
SERVICE_DEFAULT_INTERVAL_MONTHS=6
SERVICE_TIME_ZONE=Asia/Kolkata
# In-process scan cadence in minutes; 0 disables it.
PROACTIVE_SERVICE_SCHEDULER_MINUTES=60
# Set to enable POST /api/internal/proactive-service/run for an external cron (send "Authorization: Bearer <secret>").
PROACTIVE_SERVICE_CRON_SECRET=
# B2C email escalation management (see docs/b2c-escalations.md). All optional.
# true: the main API leaves B2C to the separate B2C server (npm run b2c:start), which listens on B2C_PORT.
B2C_SEPARATE_SERVER=true
B2C_PORT=5100
# Minutes between inbox polls; 0 disables the in-process poller (then use the cron endpoint).
B2C_EMAIL_POLL_MINUTES=2
# Set to enable POST /api/internal/b2c/run for an external cron (send "Authorization: Bearer <secret>").
B2C_CRON_SECRET=
# Microsoft 365 / Microsoft Graph mailbox connector (app registration with Mail.ReadWrite + Mail.Send).
# NOT verified against TCM: TCM has not confirmed its email provider or supplied credentials.
B2C_GRAPH_TENANT_ID=
B2C_GRAPH_CLIENT_ID=
B2C_GRAPH_CLIENT_SECRET=
# Incoming B2C email over IMAP (MilesWeb), for inboxes with provider "imap". IMAP is receive-only:
# acknowledgements are sent by the separate company sender below; other customer emails for
# these inboxes are recorded on the ticket but not sent.
# Set IMAP_PASS only in your local .env or the Render dashboard, never in this file or Git.
IMAP_HOST=mail.aavoraa.com
# 993 = SSL/TLS (IMAP_SECURE defaults to true); 143 = STARTTLS.
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=test1@aavoraa.com
IMAP_PASS=
IMAP_MAILBOX=INBOX
# Customer acknowledgements sent from a separate company address over authenticated SMTP
# (not the IMAP account). Off unless true; keep it off in development and tests.
# Set B2C_ACK_SMTP_PASS only in your local .env or the Render dashboard, never in this file or Git.
B2C_ACK_EMAIL_ENABLED=false
B2C_ACK_FROM_EMAIL=noreply@aavoraa.com
B2C_ACK_FROM_NAME=iPlanet Support
# Used as {{companyName}} in the template ("Regards, <name> Support Team").
B2C_ACK_COMPANY_NAME=iPlanet
B2C_ACK_SMTP_HOST=mail.aavoraa.com
# 465 = SSL/TLS (B2C_ACK_SMTP_SECURE defaults to true); 587 = STARTTLS (required).
B2C_ACK_SMTP_PORT=465
B2C_ACK_SMTP_SECURE=true
B2C_ACK_SMTP_USER=noreply@aavoraa.com
B2C_ACK_SMTP_PASS=
# verified = acknowledge only a matched customer, at their registered address; sender = also acknowledge unmatched senders.
B2C_ACK_UNMATCHED_POLICY=verified
# Customer registration links, emailed when the sender cannot be matched to a registered customer
# (docs/b2c-customer-registration.md). Off unless true. Sent by the company sender above (or an inbox
# that can send); the portal URL is the public frontend and must be HTTPS in production.
B2C_REGISTRATION_ENABLED=false
B2C_REGISTRATION_PORTAL_URL=http://localhost:5173
B2C_REGISTRATION_TTL_HOURS=72
B2C_REGISTRATION_MAX_SENDS=3
B2C_REGISTRATION_RESEND_MINUTES=15
B2C_REGISTRATION_MAX_PER_RECIPIENT_DAY=3
B2C_REGISTRATION_MAX_SUBMIT_ATTEMPTS=10
B2C_REGISTRATION_PURCHASE_DATE_TOLERANCE_DAYS=7
# Number of proxies in front of the server (e.g. 1 on Render), so rate limits see the client address.
TRUST_PROXY_HOPS=
# CRM connector: 'none' until TCM supplies its CRM API; 'test' = fictitious TEST- records (never live data).
B2C_CRM_PROVIDER=none
B2C_CRM_TIMEOUT_MS=15000
# Test adapters are disabled when NODE_ENV=production unless this is true (staging only).
B2C_ALLOW_TEST_ADAPTERS=false
# Address seeded as the single starting test inbox.
B2C_TEST_INBOX_ADDRESS=escalations@b2c-inbox.test
# Escalation reference prefix (2-6 capitals), e.g. B2C-2026-000123.
B2C_REFERENCE_PREFIX=B2C
# Domain used in outbound Message-IDs.
B2C_MESSAGE_ID_DOMAIN=sabora.local
# Attachments are stored here, outside the public /uploads folder. Use a persistent disk in production.
B2C_ATTACHMENT_DIR=
B2C_MAX_ATTACHMENT_MB=10
B2C_MAX_ATTACHMENTS=10
B2C_MAX_PROCESSING_ATTEMPTS=5
B2C_MAX_SEND_ATTEMPTS=5
B2C_MAX_CRM_ATTEMPTS=5
B2C_POLL_BATCH_SIZE=25
# Local demo B2C staff accounts (never created when NODE_ENV=production).
B2C_DEMO_ACCOUNTS=true

# Number of proxy hops in front of the API (Render: 1). Leave unset when the API is reached directly.
# Lets the sign-up rate limit see the client address instead of the proxy.
# TRUST_PROXY=1
# Email domains allowed to create iPlanet Service accounts from the sign-up page, comma separated
# (e.g. iplanet.in). Accounts are active immediately. Leave empty to turn service sign-up off.
SERVICE_SIGNUP_EMAIL_DOMAINS=
