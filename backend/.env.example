MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
FRONTEND_URLS=http://localhost:5173,https://your-vercel-app.vercel.app
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
# Log retrieved knowledge IDs and scores locally; never enable in production.
AI_KNOWLEDGE_DEBUG=false
GOOGLE_REVIEW_MODE=business-profile
GOOGLE_REVIEW_PLACE_ID=ChIJDWJ8PaWsKycR3-r2Ijr0D0I
GOOGLE_REVIEW_BUSINESS_NAME=Phoenixx IT
GOOGLE_REVIEW_SERVICE_CENTRE_NAME=Coimbatore Service Centre
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=http://localhost:5000/api/google-business/callback
GOOGLE_BUSINESS_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-business/callback
GOOGLE_REVIEW_SYNC_INTERVAL=300000
# Proactive device service (all optional; defaults shown)
# Days before the recommended date a device is "Upcoming", and days after it before "Due" becomes "Overdue".
SERVICE_UPCOMING_DAYS=30
SERVICE_OVERDUE_GRACE_DAYS=14
# Interval for devices without their own serviceIntervalMonths.
SERVICE_DEFAULT_INTERVAL_MONTHS=6
SERVICE_TIME_ZONE=Asia/Kolkata
# In-process scan cadence in minutes; 0 disables it.
PROACTIVE_SERVICE_SCHEDULER_MINUTES=60
# Set to enable POST /api/internal/proactive-service/run for an external cron (send "Authorization: Bearer <secret>").
PROACTIVE_SERVICE_CRON_SECRET=
