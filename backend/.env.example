MONGODB_URI=mongodb://127.0.0.1:27017/iplanet_portal
JWT_SECRET=local-demo-secret
PORT=5000
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,https://<your-tunnel-host>.loca.lt
OLLAMA_BASE_URL=http://localhost:11434
# Pull this model with: ollama pull qwen3:1.7b
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=60000
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000
# Log retrieved knowledge IDs and scores locally; never enable in production.
AI_KNOWLEDGE_DEBUG=false
